rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function belongsToCompany(companyId) {
      return isAuthenticated() && (
        request.auth.token.companyId == companyId ||
        request.auth.token.role == 'SUPER_ADMIN'
      );
    }
    
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 5 * 1024 * 1024; // 5MB max
    }
    
    function isValidDocument() {
      return (request.resource.contentType.matches('application/pdf') ||
              request.resource.contentType.matches('image/.*')) &&
             request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // Company assets (Logos, branding)
    match /companies/{companyId}/{allPaths=**} {
      allow read: if true; // Publicly visible for invoices/receipts
      allow write: if belongsToCompany(companyId) && isValidImage();
    }

    // Product Images
    match /products/{companyId}/{allPaths=**} {
      allow read: if true;
      allow write: if belongsToCompany(companyId) && isValidImage();
    }

    // Employee & Expense Documents
    match /documents/{companyId}/{allPaths=**} {
      allow read: if belongsToCompany(companyId);
      allow write: if belongsToCompany(companyId) && isValidDocument();
    }
  }
}
